# =============================================================================
# Docker Ignore - Exclude files from build context
# =============================================================================

# Virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Testing
.pytest_cache/
.coverage
htmlcov/
tests/

# Linting/Formatting cache
.ruff_cache/
.mypy_cache/

# Git
.git/
.gitignore

# Environment files (secrets should be injected at runtime)
.env
.env.*
!.env.example

# Documentation (not needed in container)
*.md
!README.md

# IDE
.vscode/
.idea/

# Alembic compiled files
alembic/versions/*.pyc
alembic/versions/__pycache__/

# Development Dockerfile
Dockerfile

# Misc
*.log
*.tmp

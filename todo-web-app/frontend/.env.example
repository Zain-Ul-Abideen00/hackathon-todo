# Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Database Configuration (Neon PostgreSQL - same as backend)
DATABASE_URL="postgresql://neondb_owner:your-password/neondb?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-development-secret-min-32-characters-here"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
